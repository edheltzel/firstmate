      "cleanup": [{"path": "bin/fm-teardown.sh", "tokens": ["teardown"]}],
      "rollback_owner": "omp-p7-recovery",
      "evidence_schema": "omp-evidence.v1",
      "rollback_schema": "omp-rollback.v1"
    },
    {
      "id": "pi-worker-hooks",
      "paths": ["state/{task}.pi-ext", "projects/{project}/.pi/settings.json", "projects/{project}/.pi/extensions/"],
      "creator": [{"path": "bin/fm-spawn.sh", "tokens": ["__PIEXT__"]}],
      "cleanup": [{"path": "bin/fm-teardown.sh", "tokens": ["pi-ext.ts"]}],
      "rollback_owner": "omp-p8-policy-publication",
      "evidence_schema": "omp-evidence.v1",
      "rollback_schema": "omp-rollback.v1"
    },
    {
