      "creator": [{"path": "bin/fm-spawn.sh", "tokens": ["grok-turnend-token"]}],
      "cleanup": [{"path": "bin/fm-teardown.sh", "tokens": ["grok-turnend-token"]}],
      "rollback_owner": "omp-p8-policy-publication",
      "evidence_schema": "omp-evidence.v1",
      "rollback_schema": "omp-rollback.v1"
    },
    {
