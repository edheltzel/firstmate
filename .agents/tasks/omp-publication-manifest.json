      "cleanup": [{"path": "bin/fm-lock.sh", "tokens": ["fm_lock_release"]}],
      "rollback_owner": "omp-p2-identity-adapter",
      "evidence_schema": "omp-evidence.v1",
      "rollback_schema": "omp-rollback.v1"
    },
    {
      "id": "backend-liveness",
      "paths": ["bin/fm-backend.sh", "bin/backends/tmux.sh", "bin/backends/herdr.sh", "bin/fm-crew-state.sh"],
