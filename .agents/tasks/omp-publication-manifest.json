      "cleanup": [{"path": "bin/fm-teardown.sh", "tokens": ["hooks_dir"]}],
      "rollback_owner": "omp-p8-policy-publication",
      "evidence_schema": "omp-evidence.v1",
      "rollback_schema": "omp-rollback.v1"
    },
    {
      "id": "pr-check-publication",
      "paths": ["state/{task}.check.sh", "state/{task}.check-trust", "state/{task}.pr-poll", "state/{task}.pr-poll-registration", "state/{task}.pr-publication", "state/{task}.pr-binding", "state/.pr-check-quarantine/", "state/.pr-check-migration.log"],
      "creator": [{"path": "bin/fm-pr-check.sh", "tokens": ["fm_pr_poll_prepare"]}, {"path": "bin/fm-check-register.sh", "tokens": ["check-trust"]}, {"path": "bin/fm-pr-check-migrate.sh", "tokens": ["LOG=\"$STATE/.pr-check-migration.log\"", "record_diagnostic"]}],
      "cleanup": [{"path": "bin/fm-teardown.sh", "tokens": ["pr-poll"]}],
      "rollback_owner": "omp-p8-policy-publication",
      "evidence_schema": "omp-evidence.v1",
      "rollback_schema": "omp-rollback.v1"
    },
    {
      "id": "herdr-presentation-journal",
      "paths": ["state/{task}.herdr-presentation"],
      "creator": [{"path": "bin/backends/herdr.sh", "tokens": [".herdr-presentation"]}],
      "cleanup": [{"path": "bin/fm-teardown.sh", "tokens": ["HERDR_PRESENTATION_JOURNAL"]}],
      "rollback_owner": "omp-p5-herdr-parity",
      "evidence_schema": "omp-evidence.v1",
      "rollback_schema": "omp-rollback.v1"
    },
    {
      "id": "transition-and-task-temp",
      "paths": ["state/{task}.backend-transition", "state/{task}.task-temp", "state/{task}.turn-ended", "state/{task}.grok-turnend-token"],
      "creator": [{"path": "bin/fm-spawn.sh", "tokens": ["GOTMPDIR", ".turn-ended"]}],
      "cleanup": [{"path": "bin/fm-teardown.sh", "tokens": ["turn-ended"]}],
      "rollback_owner": "omp-p3-cleanup-live",
      "evidence_schema": "omp-evidence.v1",
      "rollback_schema": "omp-rollback.v1"
    },
    {
      "id": "omp-evidence-and-rollback",
      "paths": ["data/omp-evidence/{task_id}.json", "data/omp-rollback/{task_id}.json"],
      "creator": [{"path": "bin/fm-omp-activation.sh", "tokens": ["omp-evidence"]}],
      "cleanup": [{"path": "bin/fm-omp-activation.sh", "tokens": ["omp-rollback"]}],
      "rollback_owner": "task owner from omp-manifest.json",
      "evidence_schema": "omp-evidence.v1",
      "rollback_schema": "omp-rollback.v1"
    },
    {
      "id": "omp-activation-records",
      "paths": ["data/omp-activation-preflight.json", "data/omp-activation-receipt.json"],
      "creator": [{"path": "bin/fm-omp-activation.sh", "tokens": ["omp-activation-preflight", "omp-activation-receipt"]}],
      "cleanup": [{"path": "bin/fm-omp-activation.sh", "tokens": ["activation receipt"]}],
      "rollback_owner": "omp-p1-activation-a7",
      "evidence_schema": "omp-activation-preflight.v1",
      "rollback_schema": "omp-activation-receipt.v1"
    }
